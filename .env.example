# Copy to .env and fill in. Never commit .env.

# Optional. If set, records go to MongoDB (database named in the URI).
# If empty, records are written as JSONL files to ./data/ (or DATA_DIR).
MONGO_URI=

PORT=3000

# Required for /export. Use a long random string, e.g. `openssl rand -hex 24`.
ADMIN_TOKEN=

# Optional: path to a different study config (default: ./study.yaml)
# STUDY_CONFIG=examples/same-vs-cross.yaml
# Optional: a folder of study configs; hosts them all, with the examples gallery at /
# STUDY_DIR=examples/gallery
